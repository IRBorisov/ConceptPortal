      "constituent": "F1"
    },
    {
      "id": "E2",
      "concept": "прямые роли пользователя",
      "ref": "п. 3",
      "via": "постоянные назначения ∪ временные с действующим периодом",
      "constituent": "F2"
    },
    {
      "id": "E3",
      "concept": "унаследованные роли пользователя",
      "ref": "п. 5",
      "via": "объединение младших ролей прямых ролей минус прямые",
      "constituent": "F3"
    },
    {
      "id": "E4",
      "concept": "назначенные права",
      "ref": "п. 3",
      "via": "права прямых ролей",
      "constituent": "F5"
    },
    {
      "id": "E5",
      "concept": "эффективные права",
      "ref": "п. 3",
      "via": "права прямых и унаследованных ролей",
      "constituent": "F6"
    },
    {
      "id": "E6",
      "concept": "временные назначения",
      "ref": "v2 п. 1",
      "via": "родовая структура (пользователь, роль, с, по)",
      "constituent": "S5"
    }
  ],
  "distinctions": [
    {
      "id": "V1",
      "between": ["E4", "E5"],
      "text": "назначенные права ≠ эффективные",
      "witness": "SC1"
    },
    {
      "id": "V2",
      "between": ["E2", "E3"],
      "text": "прямая роль ≠ унаследованная",
      "witness": "SC1"
    }
  ],
  "invariants": [
    {
      "id": "I1",
      "text": "В иерархии ролей нет циклов",
      "ref": "п. 2",
      "constituent": "A1",
      "positive": "SC1",
      "negative": "SC2"
    },
    {
      "id": "I2",
      "text": "Нет пользователя с обеими ролями несовместимой пары, в том числе через иерархию",
      "ref": "п. 4",
      "constituent": "A2",
      "positive": "SC1",
      "negative": "SC3"
    },
    {
      "id": "I3",
      "text": "Период временного назначения корректен",
      "constituent": "A3",
      "positive": "SC4",
      "negative": "SC6"
    }
  ],
  "decisions": [
    {
      "id": "DC1",
      "topic": "иерархия ролей",
      "alternatives": ["плоские роли без иерархии", "дерево: у роли одна старшая", "отношение S3 (старшая, младшая)"],
      "choice": "отношение S3",
      "rationale": "п. 2; роль может входить в несколько старших — дерево избыточно ограничивает"
    },
    {
      "id": "DC2",
      "topic": "права пользователя",
      "alternatives": ["структура «права пользователя» S#", "вывод через роли"],
      "choice": "вывод через роли (F5, F6)",
      "rationale": "права пользователя не задаются отдельно — иначе разойдутся с ролями"
    },
    {
      "id": "DC3",
      "topic": "разделение обязанностей",
      "alternatives": ["по прямым ролям", "по эффективным ролям"],
      "choice": "по эффективным ролям (A2)",
      "rationale": "п. 4: «в том числе через иерархию»"
    },
    {
      "id": "DC4",
      "topic": "симметричность несовместимости",
      "choice": "без аксиомы",
      "rationale": "A2 запрещает пару в любом порядке; достаточно записать пару один раз"
    },
    {
      "id": "DC5",
      "topic": "ацикличность иерархии",
      "choice": "аксиома A1 через замыкание F1",
      "rationale": "п. 2"
    },
    {
      "id": "DC6",
      "topic": "прямые роли с временными назначениями",
      "supersedes": "DC2",
      "choice": "F2 включает временные роли с действующим периодом",
      "rationale": "v2 п. 1; без временных назначений совпадает с v1"
    },
    {
      "id": "DC7",
      "topic": "временное назначение",
      "alternatives": ["период как компонента S1 (ломает v1)", "отдельная структура S5"],
      "choice": "S5 (пользователь, роль, первый день, последний день) и текущий день S6",
      "rationale": "S1 и сценарии v1 не меняются; E6 — родовая структура по DC7"
    }
  ],
  "scenarios": [
    {
      "id": "SC1",
      "title": "Администратор и наблюдатель-аудитор",
      "values": {
        "X1": ["ann", "bob"],
        "X2": ["admin", "editor", "viewer", "auditor"],
        "X3": ["read", "write", "delete", "audit"],
        "S1": [
          ["ann", "admin"],
          ["bob", "viewer"],
          ["bob", "auditor"]
        ],
        "S2": [
          ["viewer", "read"],
          ["editor", "write"],
          ["admin", "delete"],
          ["auditor", "audit"]
        ],
        "S3": [
          ["admin", "editor"],
          ["editor", "viewer"]
        ],
        "S4": [["admin", "auditor"]],
        "S6": 1
      },
      "expect": [
        {
          "of": "F1",
          "args": ["admin"],
          "value": ["editor", "viewer"]
        },
        {
          "of": "F3",
          "args": ["ann"],
          "value": ["editor", "viewer"]
        },
        {
          "of": "F3",
          "args": ["bob"],
          "value": []
        },
        {
          "of": "F5",
          "args": ["ann"],
          "value": ["delete"]
        },
        {
          "of": "F6",
          "args": ["ann"],
          "value": ["read", "write", "delete"]
        },
        {
          "of": "F6",
          "args": ["bob"],
          "value": ["read", "audit"]
        }
      ]
    },
    {
      "id": "SC2",
      "title": "Цикл в иерархии",
      "base": "SC1",
      "values": {
        "S3": [
          ["admin", "editor"],
          ["editor", "viewer"],
          ["viewer", "admin"]
        ]
      },
      "expect": [
        {
          "of": "A1",
          "holds": false
        }
      ]
    },
    {
      "id": "SC3",
      "title": "Несовместимость через наследование",
      "base": "SC1",
      "values": {
        "S1": [
          ["ann", "admin"],
          ["ann", "auditor"]
        ],
        "S4": [["editor", "auditor"]]
      },
      "expect": [
        {
          "of": "A2",
          "holds": false
        },
        {
          "of": "F2",
          "args": ["ann"],
          "value": ["admin", "auditor"]
        }
      ]
    },
    {
      "id": "SC4",
      "title": "Временная роль действует",
      "base": "SC1",
      "values": {
        "S5": [["bob", "editor", 5, 10]],
        "S6": 7
      },
      "expect": [
        {
          "of": "F2",
          "args": ["bob"],
          "value": ["editor", "viewer", "auditor"]
        },
        {
          "of": "F6",
          "args": ["bob"],
          "contains": ["write"]
        }
      ]
    },
    {
      "id": "SC5",
      "title": "Временная роль истекла",
      "base": "SC4",
      "values": {
        "S6": 12
      },
      "expect": [
        {
          "of": "F6",
          "args": ["bob"],
          "excludes": ["write"]
        }
      ]
    },
    {
      "id": "SC6",
      "title": "Период задом наперёд",
      "base": "SC1",
      "values": {
        "S5": [["bob", "editor", 10, 5]]
      },
      "expect": [
        {
          "of": "A3",
          "holds": false
        }
      ]
    }
  ],
  "assumptions": ["право — неделимый элемент, без привязки к конкретному ресурсу"],
  "openQuestions": []
}
