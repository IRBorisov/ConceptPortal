{
  "version": 1,
  "status": "confirmed",
  "approach": "project",
  "object": "Запись пациентов на приём к врачу",
  "task": "Эксплицировать слоты, записи и приёмы для проектирования модуля записи и его проверок",
  "source": "requirements-v1.md, requirements-v2.md",
  "restrictions": [
    {
      "id": "L1",
      "excludes": "уведомления (п. 6)",
      "inexpressible": ["отправленное напоминание"]
    },
    {
      "id": "L2",
      "excludes": "оплата (п. 7)",
      "inexpressible": ["оплаченный приём", "стоимость"]
    },
    {
      "id": "L3",
      "excludes": "отмены и история записей",
      "inexpressible": ["отменённая запись", "неявка в прошлом месяце"]
    }
  ],
  "expressiveness": [
    {
      "id": "E1",
      "concept": "свободные слоты",
      "ref": "п. 3",
      "via": "слоты вне Pr2 записей",
      "constituent": "D1"
    },
    {
      "id": "E2",
      "concept": "слоты, доступные пациенту",
      "ref": "п. 4",
      "via": "свободные без пересечения с записями пациента",
      "constituent": "F4"
    },
    {
      "id": "E3",
      "concept": "пересечение слотов",
      "ref": "п. 2, 4",
      "via": "тот же день и перекрытие отрезков",
      "constituent": "P1"
    },
    {
      "id": "E4",
      "concept": "состоявшиеся приёмы",
      "ref": "п. 5",
      "via": "родовая структура (пациент, слот) по DC3",
      "constituent": "S5"
    },
    {
      "id": "E5",
      "concept": "слоты врача",
      "ref": "п. 2",
      "via": "фильтр «врач слота»",
      "constituent": "F2"
    },
    {
      "id": "E8",
      "concept": "специальности врача",
      "ref": "п. 1",
      "via": "фильтр S1 по врачу",
      "constituent": "F6"
    },
    {
      "id": "E6",
      "concept": "повторные записи",
      "ref": "v2 п. 1",
      "via": "родовая структура ⊆ записей по DC5",
      "constituent": "S6"
    },
    {
      "id": "E7",
      "concept": "врачи, у которых пациент был",
      "ref": "v2 п. 1",
      "via": "врачи слотов состоявшихся приёмов",
      "constituent": "F5"
    }
  ],
  "distinctions": [
    {
      "id": "V1",
      "between": ["E1", "E2"],
      "text": "свободный слот ≠ доступный пациенту"
    },
    {
      "id": "V2",
      "between": ["S4", "S5"],
      "text": "запись ≠ приём"
    }
  ],
  "invariants": [
    {
      "id": "I1",
      "text": "На слот не больше одной записи",
      "ref": "п. 3",
      "constituent": "A1",
      "positive": "SC1",
      "negative": "SC2"
    },
    {
      "id": "I2",
      "text": "Слоты одного врача не пересекаются",
      "ref": "п. 2",
      "constituent": "A2",
      "positive": "SC1",
      "negative": "SC3"
    },
    {
      "id": "I3",
      "text": "У слота один врач и одно время",
      "constituent": "A3",
      "positive": "SC1",
      "negative": "SC6"
    },
    {
      "id": "I4",
      "text": "Начало слота раньше конца",
      "constituent": "A4",
      "positive": "SC1",
      "negative": "SC4"
    },
    {
      "id": "I5",
      "text": "Приём бывает только по записи",
      "ref": "п. 5",
      "constituent": "A5",
      "positive": "SC1",
      "negative": "SC5"
    },
    {
      "id": "I7",
      "text": "У врача есть хотя бы одна специальность",
      "ref": "п. 1",
      "constituent": "A7",
      "positive": "SC1",
      "negative": "SC9"
    },
    {
      "id": "I6",
      "text": "Повторная запись — только к врачу, у которого пациент был",
      "ref": "v2 п. 1",
      "constituent": "A6",
      "positive": "SC7",
      "negative": "SC8"
    }
  ],
  "decisions": [
    {
      "id": "DC1",
      "topic": "слот",
      "alternatives": ["слот как кортеж (врач, день, начало, конец)", "слот как сущность X4 с врачом и временем"],
      "choice": "X4 и структуры S2, S3",
      "rationale": "на слот ссылаются записи и приёмы; кортеж-слот пришлось бы повторять в каждой паре"
    },
    {
      "id": "DC2",
      "topic": "время",
      "choice": "день и минуты как Z",
      "rationale": "пересечение требует порядка и сравнения; календарные даты исключены (L3)"
    },
    {
      "id": "DC3",
      "topic": "приём",
      "alternatives": ["приём = запись", "отдельная структура S5 ⊆ записей"],
      "choice": "S5 и аксиома A5",
      "rationale": "запись ≠ приём (п. 5): пациент может не прийти"
    },
    {
      "id": "DC4",
      "topic": "специальность записи",
      "choice": "без аксиомы",
      "rationale": "в требованиях нет правила о специальности при записи"
    },
    {
      "id": "DC5",
      "topic": "первичная и повторная запись",
      "alternatives": [
        "классификация: две структуры первичных и повторных + аксиомы разбиения",
        "структура повторных; первичные — остаток"
      ],
      "choice": "S6 повторные записи; первичные — остальные записи",
      "rationale": "разбиение полное по построению; аксиома нужна только «S6 ⊆ записей»"
    }
  ],
  "scenarios": [
    {
