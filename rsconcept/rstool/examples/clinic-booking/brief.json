        "X1": ["house", "cuddy"],
        "X2": ["therapy", "surgery"],
        "X3": ["p1", "p2"],
        "X4": ["s1", "s2", "s3", "s4"],
        "S1": [
          ["house", "therapy"],
          ["cuddy", "surgery"],
          ["cuddy", "therapy"]
        ],
        "S2": [
          ["s1", "house"],
          ["s2", "house"],
          ["s3", "cuddy"],
          ["s4", "cuddy"]
        ],
        "S3": [
          ["s1", 1, 540, 570],
          ["s2", 1, 570, 600],
          ["s3", 1, 540, 600],
          ["s4", 2, 600, 630]
