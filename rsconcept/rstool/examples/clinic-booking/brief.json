          "holds": true
        },
        {
          "of": "P1",
          "args": ["s1", "s2"],
          "holds": false,
          "note": "стык 570 — не пересечение"
        },
        {
          "of": "F2",
          "args": ["house"],
          "value": ["s1", "s2"]
        },
        {
          "of": "F6",
          "args": ["cuddy"],
          "value": ["therapy", "surgery"]
        }
