  "decisions": [
    {
      "id": "DC1",
      "topic": "исходное понятие",
      "alternatives": ["два базисных множества: начальники и подчинённые", "одно: люди"],
      "choice": "X1 люди",
      "rationale": "начальники сами бывают подчинёнными и наоборот — есть более высокая абстракция (§4.2.1.4)"
    },
    {
      "id": "DC2",
      "topic": "основное отношение: первая гипотеза",
      "alternatives": ["единичное отношение", "множественное отношение", "оба"],
      "choice": "единичное отношение «человек — человек»",
      "rationale": "простейшая форма; проверяется на требованиях к выразительным средствам (§4.2.1.5.1)"
    },
    {
      "id": "DC3",
      "topic": "основное отношение после проверки выразительности",
      "supersedes": "DC2",
      "choice": "множественное отношение S1: ℬ(ℬ(X1)×ℬ(X1))",
      "rationale": "в единичном отношении три начальника одного человека — не коллективный начальник: E4–E8 невыразимы; множественное покрывает единичное одноэлементными совокупностями (§4.2.1.7)"
    },
    {
      "id": "DC4",
      "topic": "порядок пары",
      "choice": "(начальник, подчинённый)",
      "rationale": "пара упорядочена — нужно решение о жёстком порядке (§4.2.1.5.2)"
    },
    {
      "id": "DC5",
      "topic": "антирефлексивность",
      "choice": "аксиома A1: стороны одного отношения не пересекаются",
      "rationale": "отсекается психологический аспект — «сам себе не начальник» (§4.2.1.5.3); в разных отношениях человек может быть и членом руководства, и руководимым — это нужно для подчинения внутри коллектива (E6)"
    },
    {
      "id": "DC6",
      "topic": "универсальность",
      "choice": "без аксиомы",
      "rationale": "не все люди чьи-то начальники или подчинённые; отсутствие аксиомы — тоже решение (§4.2.1.5.3)"
    },
    {
      "id": "DC7",
      "topic": "симметричность",
      "choice": "без аксиомы",
      "rationale": "подчинение многоаспектно: капитан команды подчинён нападающему, который начальник отдела капитана (§4.2.1.5.3)"
    },
    {
      "id": "DC8",
      "topic": "транзитивность",
      "choice": "без аксиомы",
      "rationale": "«вассал моего вассала — не мой вассал»: косвенное подчинение не прямое (§4.2.1.5.3)"
    },
    {
      "id": "DC9",
      "topic": "однозначность",
      "choice": "без аксиомы",
      "rationale": "человек может руководить многими и быть подчинён многим (§4.2.1.5.3)"
    },
    {
      "id": "DC10",
      "topic": "непустота сторон",
      "choice": "аксиома A2",
      "rationale": "в книге подразумевается неявно (§4.2.1.8); в ЯРЭ записано явно"
    }
  ],
