    },
    {
      "id": "L2",
      "excludes": "время: бывшие, настоящие и будущие отношения",
      "inexpressible": ["мой подчинённый, который является моим бывшим начальником"]
    },
    {
      "id": "L3",
      "excludes": "процедуры формирования и изменения структуры подчинения, воспроизводство кадров",
