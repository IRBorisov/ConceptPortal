{
  "name": "@rsconcept/rstool-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol adapter for rstool over stdio or authenticated Streamable HTTP, with isolated persistent workspaces.",
  "license": "MIT",
  "author": "IRBorisov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IRBorisov/ConceptPortal.git",
    "directory": "rsconcept/rstool-mcp"
  },
  "homepage": "https://portal.acconcept.ru",
  "keywords": [
    "rslang",
    "rsform",
    "rstool",
    "mcp",
    "model-context-protocol",
    "agent",
    "llm",
    "cursor",
    "claude"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rstool-mcp": "dist/bin/server.js",
    "rstool-mcp-http": "dist/bin/http-server.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "HTTP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/bin/server.ts",
    "start:http": "tsx src/bin/http-server.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@rsconcept/rstool": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
