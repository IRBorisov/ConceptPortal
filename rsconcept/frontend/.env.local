# Local build config

VITE_PORTAL_BACKEND=http://localhost:8000
VITE_PORTAL_FRONT_PORT=3000

# Sentry (optional)
# VITE_SENTRY_DSN=

# React Scan render overlay (dev only, off by default)
# VITE_REACT_SCAN=true

# React DevTools tools for agents via Chrome DevTools MCP (dev only, off by default; slows rendering)
# VITE_REACT_DEVTOOLS_MCP=true
